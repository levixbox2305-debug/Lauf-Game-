{
  "expo": {
    "name": "Laufwelt",
    "slug": "laufwelt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zitronsystems.laufwelt"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zitronsystems.laufwelt"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Laufwelt misst deine Läufe per GPS, damit deine Welt wachsen kann.",
          "locationAlwaysAndWhenInUsePermission": "Damit dein Lauf auch bei gesperrtem Bildschirm weiter gemessen wird, braucht Laufwelt den Standort im Hintergrund.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": false
        }
      ]
    ],
    "scheme": "laufwelt"
  }
}
